        <mxCell id="t2" value="主循环与一帧流水线（main.py 138 行，60fps，预算 16.67ms）" style="text;html=1;fontSize=15;fontStyle=1" parent="1" vertex="1"><mxGeometry x="40" y="10" width="600" height="26" as="geometry" /></mxCell>
