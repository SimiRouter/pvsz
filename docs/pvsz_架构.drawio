        <mxCell id="f1" value="① 帧节奏 hybrid pacing&#10;wait(delay−2ms) 睡掉大部分 + 忙等尾帧&#10;delay&lt;−200ms → 重同步防掉帧螺旋 (main:86)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1"><mxGeometry x="330" y="150" width="260" height="60" as="geometry" /></mxCell>
